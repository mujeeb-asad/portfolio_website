---
const { id, title, accent = 'pink', class: cls = '' } = Astro.props;
---
<section id={id} class={`win win--${accent} reveal ${cls}`} aria-labelledby={`${id}-title`}>
  <header class="win__bar">
    <span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <h2 class="win__title" id={`${id}-title`}>{title}</h2>
    <span class="win__stripes" aria-hidden="true"></span>
  </header>
  <div class="win__body"><slot /></div>
</section>
