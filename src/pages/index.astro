---
import '@fontsource/press-start-2p/400.css';
import '@fontsource/vt323/400.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Window from '../components/Window.astro';
import ThemeBoot from '../components/ThemeBoot.astro';
// The two faces visible on first paint, preloaded so the heading does not reflow when they land
import displayFont from '@fontsource/press-start-2p/files/press-start-2p-latin-400-normal.woff2?url';
import bodyFont from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import { person, intro, keywords, nav, hooks, projects, tools, leadership, contact, form, quickLinks } from '../data/site.js';

const pad = (n) => String(n).padStart(2, '0');
// Never ship an unconnected form: without a key it only renders in local development.
const showForm = Boolean(form.accessKey) || import.meta.env.DEV;

const home = new URL('/', Astro.site).href;
const abs = (href) => new URL(href, Astro.site).href;
const me = { '@id': `${home}#person` };

// Structured data for search engines and AI assistants. Every fact here is also visible on the page.
const works = projects.flatMap((p) => {
  const link = (label) => p.links.find((l) => l.label === label)?.href;
  const about = { name: p.title, author: me, dateCreated: p.meta[0], description: p.prose[0] };
  const out = [];
  if (link('Paper')) out.push({ '@type': 'ScholarlyArticle', headline: p.title, ...about, url: link('Paper') });
  if (link('Code')) out.push({ '@type': 'SoftwareSourceCode', ...about, codeRepository: link('Code'), url: link('Live demo') ?? link('Code') });
  return out;
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${home}#website`, url: home, name: person.name, inLanguage: 'en' },
    {
      '@type': 'ProfilePage', '@id': `${home}#profile`, url: home, name: person.title,
      isPartOf: { '@id': `${home}#website` }, mainEntity: me, dateModified: new Date().toISOString(),
    },
    {
      '@type': 'Person', ...me, name: person.name, url: home, email: `mailto:${person.email}`,
      description: person.description, knowsAbout: keywords,
      affiliation: { '@type': 'CollegeOrUniversity', name: person.university.name, url: person.university.url, sameAs: person.university.wiki },
      sameAs: [person.github, person.linkedin],
    },
    ...works,
  ],
};
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{person.title}</title>
    <meta name="description" content={person.description} />
    <link rel="canonical" href={home} />
    <meta name="author" content={person.name} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={person.title} />
    <meta property="og:description" content={person.description} />
    <meta property="og:url" content={home} />
    <meta property="og:image" content={abs(person.ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${person.name}, ${person.description}`} />
    <meta property="profile:first_name" content="Mujeeb" />
    <meta property="profile:last_name" content="Asad" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={person.title} />
    <meta name="twitter:description" content={person.description} />
    <meta name="twitter:image" content={abs(person.ogImage)} />
    <meta name="theme-color" content="#12102a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    <ThemeBoot />
  </head>
  <body>
    <a class="skip" href="#projects">Skip to projects</a>

    <header class="menubar">
      <div class="menubar__left">
        <!-- Easter egg: the logo square cycles the colour palette -->
        <button class="logo-btn" type="button" data-palette-cycle aria-label="Change colour palette">
          <span class="menubar__logo" aria-hidden="true"></span>
        </button>
        <a class="menubar__brand" href="#top" aria-label="Back to top">
          <span class="menubar__name">{person.name}</span>
        </a>
      </div>

      <div class="menubar__right">
        <span class="menubar__clock" data-clock aria-hidden="true">00:00</span>

        <button class="mode" type="button" data-theme-toggle aria-label="Switch to light theme">
          <span class="mode__opt mode__opt--dark">Dark</span>
          <span class="mode__opt mode__opt--light">Light</span>
        </button>

        <nav class="menu" aria-label="Site">
          <details class="menu__details" data-menu>
            <summary class="menu__toggle">
              <span class="menu__icon" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="menu__word">Menu</span>
            </summary>
            <div class="menu__panel">
              <p class="menu__bar" aria-hidden="true">Jump to</p>
              <ul class="menu__list">
                {nav.map((n, i) => (
                  <li><a href={`#${n.id}`} data-menu-link><span class="menu__num">{pad(i + 1)}</span>{n.label}</a></li>
                ))}
              </ul>
              <ul class="menu__list menu__list--ext">
                {quickLinks.map((l) => (
                  <li><a href={l.href} target="_blank" rel="noopener" data-menu-link>{l.label}<span class="ext" aria-hidden="true"></span></a></li>
                ))}
              </ul>
            </div>
          </details>
        </nav>
      </div>
    </header>

    <header class="intro" id="top">
      <div class="intro__floor" aria-hidden="true"></div>
      <div class="col intro__inner">
        <h1 class="intro__hi">Hi, I'm <span class="intro__name">{person.name}</span><span class="cursor" aria-hidden="true"></span></h1>
        <div class="intro__lead">
          {intro.map((p) => <p set:html={p} />)}
        </div>
        <ul class="keywords" aria-label="Areas I work in">
          {keywords.map((k) => <li>{k}</li>)}
        </ul>
        <div class="actions">
          <a class="btn btn--primary" href={person.cv} target="_blank" rel="noopener">CV</a>
          <a class="btn" href={person.github} target="_blank" rel="noopener">GitHub</a>
          <a class="btn" href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </header>

    <main class="col">
      <section class="section" id="projects" aria-labelledby="projects-hook">
        <h2 class="hook reveal" id="projects-hook">{hooks.projects}</h2>
        <div class="stack">
          {projects.map((p, i) => (
            <Window id={p.id} title={`Project ${pad(i + 1)}`} accent={p.accent}>
              <h3 class="proj__title" id={`${p.id}-name`}>{p.title}</h3>
              <p class="proj__meta">
                {p.meta.map((m, mi) => <>{mi > 0 && <i aria-hidden="true">/</i>}<span>{m}</span></>)}
              </p>
              <div class="prose">
                {p.prose.map((t) => <p>{t}</p>)}
              </div>
              {p.links.length > 0 && (
                <div class="actions">
                  {p.links.map((l, li) => (
                    <a class={`btn${li === 0 ? ' btn--primary' : ''}`} href={l.href} target="_blank" rel="noopener">
                      {l.label}<span class="ext" aria-hidden="true"></span>
                    </a>
                  ))}
                </div>
              )}
            </Window>
          ))}
        </div>
      </section>

      <section class="section" id="tools" aria-labelledby="tools-hook">
        <h2 class="hook reveal" id="tools-hook">{hooks.tools}</h2>
        <ul class="tools reveal">
          {tools.map((t) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={t.path} /></svg>
              <span>{t.name}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="section" id="leadership" aria-labelledby="leadership-hook">
        <h2 class="hook reveal" id="leadership-hook">{hooks.leadership}</h2>
        <div class="prose prose--lg reveal">
          <p set:html={leadership} />
        </div>
      </section>

      <section class="section" id="contact" aria-labelledby="contact-hook">
        <h2 class="hook reveal" id="contact-hook">{hooks.contact}</h2>
        <div class="prose prose--lg reveal">
          <p>{showForm ? contact.lead : contact.lead.replace(/,? send me.*$/, ', drop me an email.')}</p>
        </div>

        {showForm && (
          <div class="contact__open reveal">
            <button class="btn btn--primary btn--big" type="button" data-modal-open aria-haspopup="dialog" aria-controls="message">
              <span class="tri" aria-hidden="true"></span>Send me a message
            </button>
          </div>
        )}

        <div class="contact__alt reveal">
          <div class="prose prose--lg">
            <p>{showForm ? contact.emailLead : 'You can reach me at'}</p>
          </div>
          <a class="mail" href={`mailto:${person.email}`}>{person.email}</a>
          <div class="actions">
            <a class="btn" href={person.github} target="_blank" rel="noopener">GitHub</a>
            <a class="btn" href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a>
            <a class="btn" href={person.cv} target="_blank" rel="noopener">CV</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot col">
      <span>&copy; 2026 {person.name}</span>
      <span>Thanks for stopping by</span>
    </footer>

    {showForm && (
      <dialog class="modal" id="message" aria-labelledby="message-title" data-modal>
        <div class="win win--blue modal__win" data-modal-win>
          <header class="win__bar">
            <span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <h2 class="win__title" id="message-title">New message</h2>
            <span class="win__stripes" aria-hidden="true"></span>
            <button class="win__close" type="button" data-modal-close aria-label="Close the form">
              <span aria-hidden="true">X</span>
            </button>
          </header>
          <div class="win__body modal__body">
            <form class="form" data-form data-email={person.email} action={form.endpoint} method="POST" novalidate>
              <input type="hidden" name="access_key" value={form.accessKey} />
              <input type="hidden" name="from_name" value="Portfolio contact form" />
              <input class="hp" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

              <div class="form__row">
                <div class="field">
                  <label for="f-name">Your name</label>
                  <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="f-name-err"
                    data-msg-missing="Please tell me your name." />
                  <p class="field__err" id="f-name-err"></p>
                </div>
                <div class="field">
                  <label for="f-email">Your email</label>
                  <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="f-email-err"
                    data-msg-missing="Please add your email so I can reply." data-msg-bad="That email address does not look right." />
                  <p class="field__err" id="f-email-err"></p>
                </div>
              </div>

              <div class="form__row">
                <div class="field">
                  <label for="f-org">Company or team <span class="field__opt">optional</span></label>
                  <input id="f-org" name="organisation" type="text" autocomplete="organization" maxlength="160" />
                </div>
                <div class="field">
                  <label for="f-topic">What is it about?</label>
                  <select id="f-topic" name="topic" required aria-describedby="f-topic-err" data-msg-missing="Please pick what this is about.">
                    <option value="" selected disabled>Pick one</option>
                    {form.topics.map((t) => <option value={t}>{t}</option>)}
                  </select>
                  <p class="field__err" id="f-topic-err"></p>
                </div>
              </div>

              <div class="field">
                <label for="f-msg">Message</label>
                <textarea id="f-msg" name="message" rows="6" required maxlength="5000" aria-describedby="f-msg-err"
                  data-msg-missing="Please write a short message."></textarea>
                <p class="field__err" id="f-msg-err"></p>
              </div>

              <div class="form__foot">
                <button class="btn btn--primary" type="submit">Send message</button>
                <p class="form__status" data-form-status role="status" aria-live="polite"></p>
              </div>
            </form>
          </div>
        </div>
      </dialog>
    )}

    <script>
      const root = document.documentElement;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Theme: the switch shows both options, the active one is filled
      const themeBtn = document.querySelector('[data-theme-toggle]');
      const syncTheme = () => {
        const dark = root.getAttribute('data-theme') !== 'light';
        themeBtn?.setAttribute('aria-label', dark ? 'Dark mode on. Switch to light mode' : 'Light mode on. Switch to dark mode');
      };
      // Keeps the browser bar colour in step with the page background
      const metaTheme = document.querySelector('meta[name="theme-color"]');
      const syncMeta = () => metaTheme?.setAttribute('content', getComputedStyle(root).getPropertyValue('--bg').trim());

      // Brief cross-fade so palette and theme changes feel smooth
      let fadeTimer = 0;
      const crossFade = () => {
        if (reduce) return;
        root.classList.add('palette-shift');
        clearTimeout(fadeTimer);
        fadeTimer = setTimeout(() => root.classList.remove('palette-shift'), 450);
      };

      themeBtn?.addEventListener('click', () => {
        const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        crossFade();
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        syncTheme();
        syncMeta();
      });
      syncTheme();
      syncMeta();

      // Easter egg: the logo square cycles through the colour palettes
      const PALETTES = ['candy', 'meadow', 'cherry'];
      const cycle = document.querySelector('[data-palette-cycle]');
      cycle?.addEventListener('click', () => {
        const now = root.getAttribute('data-palette') || 'candy';
        const next = PALETTES[(PALETTES.indexOf(now) + 1) % PALETTES.length];
        crossFade();
        if (next === 'candy') root.removeAttribute('data-palette');
        else root.setAttribute('data-palette', next);
        try { localStorage.setItem('palette', next); } catch (e) {}
        cycle.classList.remove('spin');
        void cycle.offsetWidth;
        cycle.classList.add('spin');
        syncMeta();
      });

      // Menu: closes on a link, a click outside, or Escape
      const menu = document.querySelector('[data-menu]');
      if (menu) {
        const toggle = menu.querySelector('summary');
        const close = (refocus) => { if (menu.open) { menu.open = false; if (refocus) toggle.focus(); } };
        menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => close(false)));
        document.addEventListener('click', (e) => { if (!menu.contains(e.target)) close(false); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(true); });
        menu.addEventListener('toggle', () => {
          if (menu.open) menu.querySelector('[data-menu-link]')?.focus({ preventScroll: true });
        });
      }

      // Clock
      const clock = document.querySelector('[data-clock]');
      const tick = () => {
        const d = new Date();
        if (clock) clock.textContent = String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
      };
      tick();
      setInterval(tick, 15000);

      // Blocks rise in as they enter the viewport
      const reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !reduce) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }
        }, { threshold: 0.01, rootMargin: '0px 0px -8% 0px' });
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('in'));
      }

      // Message popup: a retro window over a blurred page
      const modal = document.querySelector('[data-modal]');
      if (modal instanceof HTMLDialogElement) {
        const win = modal.querySelector('[data-modal-win]');
        let opener = null;
        const open = (e) => {
          opener = e?.currentTarget || null;
          modal.classList.remove('is-closing');
          modal.showModal();
          modal.querySelector('#f-name')?.focus();
        };
        const close = () => {
          if (!modal.open || modal.classList.contains('is-closing')) return;
          if (reduce) { modal.close(); return; }
          modal.classList.add('is-closing');
          win.addEventListener('animationend', () => { modal.classList.remove('is-closing'); modal.close(); }, { once: true });
        };
        document.querySelectorAll('[data-modal-open]').forEach((b) => b.addEventListener('click', open));
        modal.querySelectorAll('[data-modal-close]').forEach((b) => b.addEventListener('click', close));
        // Escape plays the same closing animation
        modal.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
        // A click on the blurred backdrop (outside the window) closes it; typed text is kept
        modal.addEventListener('mousedown', (e) => { if (e.target === modal) close(); });
        modal.addEventListener('close', () => opener?.focus());
      }

      // Contact form: required fields are checked here, then it goes to Web3Forms, which emails it on
      const formEl = document.querySelector('[data-form]');
      if (formEl instanceof HTMLFormElement) {
        const status = formEl.querySelector('[data-form-status]');
        const submit = formEl.querySelector('button[type="submit"]');
        const email = formEl.dataset.email;
        const win = formEl.closest('[data-modal-win]');
        const required = [...formEl.querySelectorAll('[required]')];
        const say = (state, text) => { if (status) { status.dataset.state = state; status.textContent = text; } };
        const looksLikeEmail = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

        const check = (field) => {
          const value = field.value.trim();
          let msg = '';
          if (!value) msg = field.dataset.msgMissing;
          else if (field.type === 'email' && !looksLikeEmail(value)) msg = field.dataset.msgBad;
          if (msg) field.setAttribute('aria-invalid', 'true');
          else field.removeAttribute('aria-invalid');
          const err = document.getElementById(field.getAttribute('aria-describedby'));
          if (err) err.textContent = msg;
          return !msg;
        };

        // Once a field has been flagged, it re-checks as the visitor fixes it
        required.forEach((f) => {
          const recheck = () => { if (f.hasAttribute('aria-invalid')) check(f); };
          f.addEventListener('input', recheck);
          f.addEventListener('change', recheck);
        });

        formEl.addEventListener('submit', async (e) => {
          e.preventDefault();
          const bad = required.filter((f) => !check(f));
          if (bad.length) {
            say('error', bad.length === 1 ? 'One field still needs filling in.' : `${bad.length} fields still need filling in.`);
            bad[0].focus();
            if (win && !reduce) { win.classList.remove('shake'); void win.offsetWidth; win.classList.add('shake'); }
            return;
          }
          const data = new FormData(formEl);
          if (data.get('botcheck')) return;
          if (!data.get('access_key')) {
            say('error', 'The form is not connected yet. Add the access key in src/data/site.js.');
            return;
          }
          data.set('subject', `Portfolio: ${data.get('topic')} from ${data.get('name')}`);
          submit.disabled = true;
          say('busy', 'Sending...');
          try {
            // Sent as plain form data: a simple request, so the browser skips the CORS pre-check
            const res = await fetch(formEl.action, {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: data,
            });
            const json = await res.json().catch(() => ({}));
            if (!res.ok || !json.success) throw new Error(json.message || 'Request failed');
            formEl.reset();
            say('ok', 'Message sent. Thanks, I will get back to you soon.');
          } catch (err) {
            say('error', `That did not go through. Please email me at ${email} instead.`);
          } finally {
            submit.disabled = false;
          }
        });
      }
    </script>
  </body>
</html>
